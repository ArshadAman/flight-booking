# Django Settings
DEBUG=1
SECRET_KEY=django-insecure-mvp-flight-booking-key
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Settings
DATABASE_URL=postgres://postgres:postgres@db:5432/flight_booking

# Redis & Celery
REDIS_URL=redis://redis:6379/0

# Flight API Provider (FlyShop UAT)
FLIGHT_API_BASE_URL=http://uat.flyshop.in/
FLIGHT_API_USER_ID=your_user_id
FLIGHT_API_PASSWORD=your_password
FLIGHT_API_IP_ADDRESS=your_ip
FLIGHT_API_IMEI=your_imei

# Razorpay Settings
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
